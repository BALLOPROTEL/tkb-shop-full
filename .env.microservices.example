# Never commit real secrets.

# Auth is the exclusive JWT authority.
JWT_SECRET=replace-with-a-long-random-secret

# Shared infrastructure endpoint; each stateful service uses its own logical DB.
MONGO_URI=mongodb://mongo:27017
AUTH_MONGO_DB_NAME=tkb_auth
CATALOG_MONGO_DB_NAME=tkb_catalog
ORDERS_MONGO_DB_NAME=tkb_orders
BACKOFFICE_MONGO_DB_NAME=tkb_backoffice

# Protects internal service-to-service contracts.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token

# When set, business services only accept /api/* traffic forwarded by the Gateway.
GATEWAY_SHARED_TOKEN=replace-with-a-long-random-gateway-token

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Payment providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
